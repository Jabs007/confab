{
  "name": "karto-ecommerce",
  "version": "1.0.0",
  "description": "Karto - A modern, responsive HTML template for furniture and home decor e-commerce websites.",
  "main": "karto/index.html",
  "scripts": {
    "start": "npx http-server karto -p 8000 -o",
    "dev": "npx http-server karto -p 8000 -o -c-1",
    "lint": "eslint karto/**/*.js",
    "lint:fix": "eslint karto/**/*.js --fix",
    "format": "prettier --write \"karto/**/*.{html,css,js,json}\"",
    "format:check": "prettier --check \"karto/**/*.{html,css,js,json}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jabs007/confab.git"
  },
  "keywords": [
    "ecommerce",
    "template",
    "html",
    "css",
    "bootstrap",
    "furniture",
    "shopping-cart",
    "responsive",
    "website-template"
  ],
  "author": "Adams Jabali <adamsjabali9@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Jabs007/confab/issues"
  },
  "homepage": "https://github.com/Jabs007/confab#readme",
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "prettier": "^3.7.4"
  }
}